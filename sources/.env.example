# ============================================================
# MySQL 8 (Aiven) — kết nối production
# ============================================================
DB_HOST=mysql-xxxxx.your-project.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_password
DB_SSL=true
DB_SSL_CA=prisma/ca.pem
DB_NAME=xuoi_mien_song_nuoc_db

# Chuỗi Prisma dùng cho production.
# Windows: Prisma CLI không nạp được CA riêng qua sslca -> dùng accept_invalid_certs
# (kết nối vẫn được mã hoá TLS). Trên Linux có thể đổi thành sslaccept=strict.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?sslaccept=accept_invalid_certs&connection_limit=5&connect_timeout=20"

# ============================================================
# Database dev / test (tuỳ chọn, dùng với scripts/with-db.mjs)
# ============================================================
# DEV_DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/xuoi_mien_song_nuoc_dev?sslaccept=accept_invalid_certs&connection_limit=5&connect_timeout=20"
# TEST_DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/xuoi_mien_song_nuoc_test?sslaccept=accept_invalid_certs&connection_limit=5&connect_timeout=20"

# ============================================================
# Bảo mật (BẮT BUỘC khi chạy app)
# ============================================================
# AUTH_SECRET: khoá ký JWT phiên admin, tối thiểu 32 ký tự.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change_me_to_a_random_string_at_least_32_chars

# IP_HASH_SALT: muối băm IP khách (lưu ip_hash, không lưu IP thô).
IP_HASH_SALT=change_me_to_another_random_string

# ============================================================
# Seed dữ liệu
# ============================================================
# Chỉ đặt khi thật sự muốn seed lên production (mặc định seed sẽ từ chối
# chạy khi NODE_ENV=production).
# SEED_ALLOW_PROD=1

# Ghi đè nhóm settings (hotline, Zalo, chính sách...) kể cả khi đã tồn tại.
# SEED_FORCE_SETTINGS=1

# Tài khoản admin do seed tạo — CHỈ tạo nếu email chưa tồn tại.
# Chạy lại seed KHÔNG reset mật khẩu tài khoản đã có.
# ADMIN_EMAIL=admin@xuoiemiensongnuoc.vn
# ADMIN_PASSWORD=doi_mat_khau_nay_ngay

# ============================================================
# Khác
# ============================================================
# Cloudinary (chưa dùng ở giai đoạn backend hiện tại)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# URL công khai của site (dùng khi cần tạo link tuyệt đối)
# NEXT_PUBLIC_SITE_URL=https://xuoiemiensongnuoc.vn
